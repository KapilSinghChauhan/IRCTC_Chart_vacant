# Data source: auto (saved fixture, then Chrome CDP live charts), fixture,
# synthetic, live (CDP), or http (direct Python HTTP, usually blocked).
DATA_SOURCE=auto

# Chrome DevTools endpoint for the hidden charts Chrome (Xvfb, no visible window).
CHROME_CDP=http://127.0.0.1:9222
# CHARTS_XVFB_DISPLAY=:99

# Optional live session for DATA_SOURCE=http only. Never commit these files.
# IRCTC_COOKIE_FILE=/absolute/path/to/cookies.txt
# IRCTC_COOKIES=name=value; other=value

# Optional override of the public charts origin.
# IRCTC_CHARTS_ORIGIN=https://www.irctc.co.in

# Request timeout seconds (in-page fetch and CDP evaluate).
IRCTC_TIMEOUT_SECONDS=20
